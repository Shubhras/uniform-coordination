      "static/chunks/app/(public-pages)/admin-form/page.js"
    ],
    "/(public-pages)/users-permissions/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(public-pages)/users-permissions/page.js"
    ],
    "/(public-pages)/users-permissions/[userId]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(public-pages)/users-permissions/[userId]/page.js"
    ],
    "/(public-pages)/pricing-packages/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(public-pages)/pricing-packages/page.js"
    ],
    "/(public-pages)/pricing-packages/view/[promotionId]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(public-pages)/pricing-packages/view/[promotionId]/page.js"
    ]
  }
